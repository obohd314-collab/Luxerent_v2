{
  "entities": {
    "users": {
      "title": "User",
      "description": "User account profiles and preferences.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique user ID matching their FirebaseAuth UID." },
        "name": { "type": "string", "description": "Display name of the user." },
        "email": { "type": "string", "description": "Primary email address of the user." },
        "avatarUrl": { "type": "string", "description": "Avatar image URL." },
        "role": { "type": "string", "enum": ["tenant", "landlord", "admin"], "description": "Role of the user in the portal." },
        "phone": { "type": "string", "description": "Contact telephone number." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user account was provisioned." },
        "favorites": { "type": "array", "description": "List of property IDs favorited by this user." }
      },
      "required": ["id", "name", "email", "role", "createdAt"]
    },
    "properties": {
      "title": "Property Rental Listing",
      "description": "Rental properties listed on the portal.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier of the listing." },
        "title": { "type": "string", "description": "Header title of the property listing." },
        "description": { "type": "string", "description": "Detailed description text." },
        "price": { "type": "number", "description": "Monthly rental price in local currency (e.g. Naira \u20a6)." },
        "location": { "type": "string", "description": "State or region in Nigeria." },
        "address": { "type": "string", "description": "Exact property physical address." },
        "propertyType": { "type": "string", "enum": ["apartment", "penthouse", "villa", "duplex", "studio"], "description": "Category of property." },
        "bedrooms": { "type": "integer", "description": "Count of bedrooms." },
        "bathrooms": { "type": "integer", "description": "Count of bathrooms." },
        "amenities": { "type": "array", "description": "Array of specific amenities (e.g. WiFi, Pool, Security)." },
        "images": { "type": "array", "description": "URLs of multiple images stored in storage or placeholders." },
        "videoTourUrl": { "type": "string", "description": "Optional video stream tour link." },
        "status": { "type": "string", "enum": ["available", "rented"], "description": "Listing lease status." },
        "landlordId": { "type": "string", "description": "User ID of the property landlord/agent." },
        "landlordName": { "type": "string", "description": "Name of the presenting landlord/agent." },
        "isApproved": { "type": "boolean", "description": "Approval status by the portal moderation team." },
        "views": { "type": "integer", "description": "Number of times this listing has been viewed." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Record creation timestamp." }
      },
      "required": ["id", "title", "description", "price", "location", "address", "propertyType", "bedrooms", "bathrooms", "status", "landlordId", "isApproved", "views", "createdAt"]
    },
    "inquiries": {
      "title": "Tenant Inquiry or Inspection Booking",
      "description": "Leads generated by tenants calling or arranging visits with landlords.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique log ID." },
        "propertyId": { "type": "string", "description": "Target property identifier." },
        "propertyTitle": { "type": "string", "description": "Title reference of the property." },
        "landlordId": { "type": "string", "description": "Owner of the property." },
        "tenantId": { "type": "string", "description": "User ID of the interested tenant." },
        "tenantName": { "type": "string", "description": "Name of the inquiring tenant." },
        "tenantEmail": { "type": "string", "description": "Email of the inquiring tenant." },
        "message": { "type": "string", "description": "Personalized description or questions." },
        "type": { "type": "string", "enum": ["message", "inspection"], "description": "Inquiry type." },
        "inspectionDate": { "type": "string", "description": "Optional planned inspection date." },
        "inspectionTime": { "type": "string", "description": "Optional planned inspection hour." },
        "status": { "type": "string", "enum": ["pending", "responded", "confirmed"], "description": "Status of transaction." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of creation." }
      },
      "required": ["id", "propertyId", "propertyTitle", "landlordId", "tenantId", "tenantName", "tenantEmail", "message", "type", "status", "createdAt"]
    },
    "chats": {
      "title": "Chat Session",
      "description": "Chat session record connecting landlord and potential tenant.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique session chat ID." },
        "propertyId": { "type": "string", "description": "Target property in chat context." },
        "propertyTitle": { "type": "string", "description": "Reference property title." },
        "landlordId": { "type": "string", "description": "Owner identifier." },
        "landlordName": { "type": "string", "description": "Name of the landlord." },
        "tenantId": { "type": "string", "description": "Sender identifier." },
        "tenantName": { "type": "string", "description": "Name of the tenant." },
        "lastMessage": { "type": "string", "description": "Excerpt of most recent chat message text." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Time of last activity." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Time room was established." }
      },
      "required": ["id", "propertyId", "propertyTitle", "landlordId", "landlordName", "tenantId", "tenantName", "lastMessage", "updatedAt", "createdAt"]
    },
    "messages": {
      "title": "Chat Room Message",
      "description": "Messages inside a specific chat room.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Message log ID." },
        "senderId": { "type": "string", "description": "UID of the message author." },
        "senderName": { "type": "string", "description": "Author display name." },
        "text": { "type": "string", "description": "Plain body text." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When message was sent." }
      },
      "required": ["id", "senderId", "senderName", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile document indexed by Firebase Authentication UID."
    },
    "/properties/{propertyId}": {
      "schema": "properties",
      "description": "Real-estate property rental listings indexed by listing ID."
    },
    "/inquiries/{inquiryId}": {
      "schema": "inquiries",
      "description": "Inspection booking or general lead inquiries indexed by inquiry ID."
    },
    "/chats/{chatId}": {
      "schema": "chats",
      "description": "Active chat channels between tenants and landlords."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "messages",
      "description": "Chat statements inside a parent chat session room."
    }
  }
}
